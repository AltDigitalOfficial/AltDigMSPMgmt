#!/usr/bin/env bash
# Pre-commit: validate templates and refuse to commit personal data.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Hard stop: these hold names, emails and phone numbers.
#
# Matched as whole lines against an explicit list rather than a pattern, so a
# new config file is only ever protected by being added here deliberately. A
# pattern like 'config/*.env' would silently also block platform.env, which is
# meant to be committed.
for PROTECTED in config/contacts.env config/identity.env; do
  if git diff --cached --name-only | grep -qx "${PROTECTED}"; then
    echo "BLOCKED: ${PROTECTED} contains personal data and must not be committed." >&2
    echo "         git restore --staged ${PROTECTED}" >&2
    exit 1
  fi
done

CHANGED="$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(org|identity|baseline)/.*\.ya?ml$' || true)"
[[ -n "${CHANGED}" ]] || exit 0

if command -v cfn-lint >/dev/null 2>&1; then
  echo "pre-commit: cfn-lint"
  # shellcheck disable=SC2086
  (cd "${REPO_ROOT}" && cfn-lint ${CHANGED})
else
  echo "pre-commit: cfn-lint not installed — skipping (run scripts/setup-tooling.sh)" >&2
fi

if command -v cfn-guard >/dev/null 2>&1; then
  echo "pre-commit: cfn-guard"
  for t in ${CHANGED}; do
    (cd "${REPO_ROOT}" && cfn-guard validate \
      --rules policies/guard --data "${t}" --show-summary fail)
  done
else
  echo "pre-commit: cfn-guard not installed — skipping (run scripts/setup-tooling.sh)" >&2
fi

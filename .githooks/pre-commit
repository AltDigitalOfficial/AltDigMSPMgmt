#!/usr/bin/env bash
# Pre-commit: validate templates and refuse to commit personal data.
#
# This hook FAILS when cfn-lint or cfn-guard are missing. It used to skip them
# with a warning, which was the wrong behaviour and quietly wrong for a whole
# session: every commit printed "skipping" and exited zero, so the output looked
# like validation had run. Fourteen guard rules sat unexecuted against six
# templates.
#
# Skipping is defensible while a tool is genuinely optional. Once it is part of
# the definition of done, a hook that passes without running it is worse than no
# hook, because it manufactures confidence.
#
# SKIP_VALIDATION=1 git commit  bypasses deliberately and visibly.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
source "${REPO_ROOT}/scripts/lib/common.sh"

# ---------------------------------------------------------------------------
# Hard stop: files carrying personal data or credentials
# ---------------------------------------------------------------------------
# This was a single exact-match test for config/contacts.env.
# config/identity.env holds the same class of data and was never added.
# terraform.tfvars holds responder email addresses, and terraform.tfstate holds
# PagerDuty routing keys in cleartext — neither existed when the line was
# written, and neither would have been caught.
#
# .gitignore already covers all four. This is the second layer, for the case
# where someone used `git add -f` or edited the ignore rule. Both layers are
# pattern-based now, for the same reason scripts/validate.sh stopped
# enumerating directories by name: a list that has to be remembered eventually
# will not be.
BLOCKED="$(git diff --cached --name-only \
  | grep -Ei '(^|/)(contacts|identity)\.env($|\.)|\.tfvars(\.json)?$|\.tfstate($|\.)|(^|/)\.env$|\.questionnaire\.(ya?ml|json)$' \
  | grep -v '\.example$' || true)"
if [[ -n "${BLOCKED}" ]]; then
  echo "BLOCKED: these staged files carry personal data or credentials:" >&2
  echo "${BLOCKED}" | sed 's/^/         /' >&2
  echo "" >&2
  echo "         git restore --staged <path>" >&2
  echo "         There is no SKIP_VALIDATION bypass for this check." >&2
  exit 1
fi

CHANGED="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^(org|baseline|security|alerting)/.*\.ya?ml$' || true)"
POLICIES="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^policies/(scp|rcp)/.*\.json$' || true)"
TFFILES="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.tf$' || true)"

[[ -n "${CHANGED}" || -n "${POLICIES}" || -n "${TFFILES}" ]] || exit 0

if [[ "${SKIP_VALIDATION:-0}" == "1" ]]; then
  echo "pre-commit: SKIP_VALIDATION=1 — validation deliberately bypassed" >&2
  exit 0
fi

if [[ -n "${CHANGED}" ]]; then
  LINT="$(find_tool cfn-lint)" || {
    echo "pre-commit: cfn-lint not found. Run scripts/setup-tooling.sh," >&2
    echo "            or SKIP_VALIDATION=1 git commit to bypass deliberately." >&2
    exit 1; }
  GUARD="$(find_tool cfn-guard)" || {
    echo "pre-commit: cfn-guard not found. Run scripts/setup-tooling.sh," >&2
    echo "            or SKIP_VALIDATION=1 git commit to bypass deliberately." >&2
    exit 1; }

  echo "pre-commit: cfn-lint"
  # shellcheck disable=SC2086
  (cd "${REPO_ROOT}" && "${LINT}" ${CHANGED})

  echo "pre-commit: cfn-guard"
  for t in ${CHANGED}; do
    (cd "${REPO_ROOT}" && "${GUARD}" validate \
      --rules "$(win_path "${REPO_ROOT}/policies/guard")" \
      --data "$(win_path "${REPO_ROOT}/${t}")" --show-summary fail)
  done
fi

# Terraform: formatting only, not `validate`.
#
# `terraform validate` requires an initialised working directory, which means a
# provider download on any machine that has not run init — turning a commit
# into a network operation that fails offline. `fmt -check` needs nothing and
# catches the thing that actually causes noise in review: a diff where half the
# changed lines are realignment.
#
# Correctness of the PagerDuty configuration is established by `terraform plan`
# in scripts/pagerduty-apply.sh, which is where it belongs — against real
# credentials and real remote state.
if [[ -n "${TFFILES}" ]]; then
  if TF="$(find_tool terraform)"; then
    echo "pre-commit: terraform fmt"
    (cd "${REPO_ROOT}" && "${TF}" fmt -check -recursive pagerduty) || {
      echo "pre-commit: run 'terraform fmt -recursive pagerduty' and restage." >&2
      exit 1; }
  else
    echo "pre-commit: terraform not found. Run scripts/setup-tooling.sh," >&2
    echo "            or SKIP_VALIDATION=1 git commit to bypass deliberately." >&2
    exit 1
  fi
fi

# Policy documents are not CloudFormation; Access Analyzer is what understands
# them. It needs credentials, so absence of credentials is a skip rather than a
# failure — unlike the local tools, this one cannot be installed away.
if [[ -n "${POLICIES}" ]]; then
  if aws sts get-caller-identity >/dev/null 2>&1; then
    echo "pre-commit: validate-policies"
    (cd "${REPO_ROOT}" && bash scripts/validate-policies.sh ${POLICIES})
  else
    echo "pre-commit: no AWS credentials — policy validation skipped" >&2
  fi
fi

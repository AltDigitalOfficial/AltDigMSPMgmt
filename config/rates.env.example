# Support pricing. design/10-commercial-model.md, "Support pricing".
#
# Copy to config/rates.env and fill in the AGREED figures. That file is
# gitignored: a rate is a commercial term, not source, and it should not be in
# git history or on a screenshare.
#
# design 10 gives indicative figures of ~$1,000 per account per month and
# 15-20% of AWS spend, and says in the same breath:
#
#     Model A is materially less work than Model B. The flat fee and percentage
#     should differ accordingly. Worth pricing before the first contract rather
#     than after.
#
# So these are a starting point somebody still has to decide. Nothing defaults
# to them: the report refuses to run until this file exists, because an
# indicative figure that reaches a customer becomes the price.
#
# One pair per service model. RATE_<MODEL>_FLAT and RATE_<MODEL>_PERCENT, both
# required — a model with only one would bill a flat fee with no uplift, or the
# reverse, and the report would look entirely correct.

# Used when a tenant has no service model recorded in the registry.
RATE_DEFAULT_FLAT=""
RATE_DEFAULT_PERCENT=""

# design 10's service models, named with the questionnaire's letters (1.7),
# which are also the registry's service_model values:
#   A  infrastructure      B  managed platform      C  fully managed
# Until 2026-09-30 these were MANAGED, CO-MANAGED and ADVISORY, a vocabulary
# nothing else used. A real rates.env with the old names still loads, but no
# tenant would match it and every one would be reported unbillable.
RATE_A_FLAT=""
RATE_A_PERCENT=""

RATE_B_FLAT=""
RATE_B_PERCENT=""

RATE_C_FLAT=""
RATE_C_PERCENT=""

# Until this is true, every report carries a warning that it is an estimate and
# must not be sent to a customer. Set it when the figures are agreed, not when
# they are plausible.
RATES_ARE_CONTRACTUAL="false"

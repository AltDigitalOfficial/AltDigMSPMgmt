# AWS alternate contacts for the management account.
#
# Copy to config/contacts.env and fill in. That file is gitignored: it holds
# personal data (names, direct emails, phone numbers) and must not enter
# version control.
#
# AWS sends billing, operations and security notices to these addresses.
# They are separate from the root email, and leaving them unset means every
# notice reaches only the root mailbox.
#
# Phone numbers: bare 10-digit US (6125550123), 11-digit (16125550123), or
# international with a leading + are all accepted. The bootstrap script
# normalises to E.164 before calling AWS. Formatting characters -- spaces,
# parentheses, hyphens, dots -- are stripped.

CONTACT_BILLING_NAME=""
CONTACT_BILLING_TITLE=""
CONTACT_BILLING_EMAIL=""
CONTACT_BILLING_PHONE=""

CONTACT_OPERATIONS_NAME=""
CONTACT_OPERATIONS_TITLE=""
CONTACT_OPERATIONS_EMAIL=""
CONTACT_OPERATIONS_PHONE=""

CONTACT_SECURITY_NAME=""
CONTACT_SECURITY_TITLE=""
CONTACT_SECURITY_EMAIL=""
CONTACT_SECURITY_PHONE=""

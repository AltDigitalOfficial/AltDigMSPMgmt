# HIPAA eligibility contacts. docs/hipaa-eligibility.md, E5 and E8.
#
# Copy to config/hipaa-contacts.env and fill in. That file is gitignored and
# blocked by the pre-commit hook: it holds direct email addresses.
#
# Published by scripts/sync-hipaa-alerts.sh:
#   - each tenant's alert EMAIL becomes an SNS email subscription on the tenant
#     alert topic, filtered to that tenant (the address is held by SNS, not SSM);
#   - each tenant's JIRA_* values become /platform/eligibility/tenant-alerts in
#     Audit, read by eligibility/src/tenant_jira.py.
#
# Tenants are <partner>-<client>, written with '_' for '-' in variable names.

# Tenants with HIPAA alerting, space-separated.
HIPAA_ALERT_TENANTS="examplepartner-exampleclient"

# E8: who hears about a CRITICAL finding in dev or test, and where the ticket goes.
examplepartner_exampleclient_EMAIL="contact@example.com"
examplepartner_exampleclient_JIRA_SITE="https://example.atlassian.net"
examplepartner_exampleclient_JIRA_PROJECT="EXAMPLE"
examplepartner_exampleclient_JIRA_ISSUE_TYPE="Task"

# E5: who approves HIPAA eligibility exceptions for AltDigital (B-162, not yet
# built). The delegate acts only when the approver is unavailable, and neither
# may approve a request he also requested or attested.
HIPAA_EXCEPTION_APPROVER="approver@example.com"
HIPAA_EXCEPTION_DELEGATE="delegate@example.com"

# AltDigital Managed Platform — central configuration
#
# Single source of truth for values that appear in more than one place.
# Sourced by every script in scripts/. Shell-safe: no spaces around '=',
# no command substitution.

# ---------------------------------------------------------------------------
# Organization management account
# ---------------------------------------------------------------------------
# Holds the Organization and nothing else. No workloads, no pipelines.
PLATFORM_MGMT_ACCOUNT_ID=738815759702

# Root email for the management account.
# DESIGN DEVIATION (B14): this is currently an alias onto jamie@altdigital.ai,
# not a monitored distribution list. See docs/deviations.md.
PLATFORM_ROOT_EMAIL=msp-mgmt@altdigital.ai

# IAM account alias for the management account. Globally unique across all AWS.
PLATFORM_MGMT_ALIAS=altdigital-msp-mgmt

# AWS CLI profile used for every script in scripts/, unless AWS_PROFILE is
# already set in the environment.
#
# This exists because of a near-miss. With AWS_PROFILE unset, this workstation's
# default credentials resolve to an IAM user in an UNRELATED AWS account
# (a different project entirely). Nothing about that is obvious: the AWS CLI
# reports success, and scripts that only call require_cli carry on happily.
#
# scripts/validate.sh did exactly that on 2026-09-17 — it validated all eleven
# platform CloudFormation templates against someone else's account and printed
# eleven green ok lines. Harmless for ValidateTemplate; not harmless as a habit,
# and the same unset variable in front of a mutating script is a very different
# day.
#
# require_account is the backstop for anything that mutates. This is the thing
# that stops the backstop being needed.
PLATFORM_AWS_PROFILE=msp-mgmt

# ---------------------------------------------------------------------------
# Regions
# ---------------------------------------------------------------------------
# Home region. Also the IAM Identity Center home region, which CANNOT be
# changed without deleting and recreating the Identity Center instance.
PLATFORM_HOME_REGION=us-east-2

# Regions member accounts may operate in. Enforced later by the region-
# restriction SCP (prompt 10.2). us-east-1 is present because global service
# endpoints (IAM, Organizations, CloudFront, Route 53, ACM-for-CloudFront)
# are served from it and denying it breaks those calls.
#
# us-west-1 is deliberately EXCLUDED: it exposes only two AZs to most accounts
# and lags on service availability, which is a poor fit for a multi-AZ
# production baseline. Design doc 02 lists it; we are narrowing that list.
PLATFORM_ALLOWED_REGIONS=us-east-1,us-east-2,us-west-2

# ---------------------------------------------------------------------------
# Naming
# ---------------------------------------------------------------------------
# Account alias prefix. Aliases are globally unique across ALL of AWS, not just
# within this Organization.
#
# This was 'ad-', on the assumption from open item B15 that the prefix was
# enough to avoid collision. It was not: 'ad-security-audit' is held by an
# unrelated AWS customer. Platform account names are generic words — audit,
# backup, shared — so a short prefix leaves them very guessable.
#
# 'altdig' is distinctive enough that collision is implausible. It costs four
# characters against the 63-char alias limit, which is why partner and client
# slugs cap at 18 rather than 20:
#
#   altdig- + 18 partner + 1 + 18 client + 1 + 10 app + 1 + 4 env = 60 of 63
PLATFORM_ACCOUNT_PREFIX=altdig

# Base for plus-addressed MEMBER account root emails, e.g.
#   mspr+oeight-arc8-p@altdigital.ai
#   mspr+oeight-avergent-cms-u@altdigital.ai
#
# Deliberately a DIFFERENT mailbox from PLATFORM_ROOT_EMAIL above. The
# management account root is a far higher-value target than any member account
# root — it cannot be constrained by any SCP or RCP — so the two get different
# mailboxes and, once they are shared mailboxes, different access lists.
#
# Short on purpose. The local part is capped at 64 octets by RFC 5321, and that
# is a tighter constraint than the 63-character AWS account alias. Every octet
# spent on the base is one unavailable to partner, client and application
# slugs. 'mspr' over 'msp-mgmt' buys four; a one-character tier buys three more.
#
# Note there is no 'ad-' prefix here. That exists on the account alias because
# aliases are globally unique across all of AWS; an email only needs to be
# unique within this domain.
PLATFORM_EMAIL_LOCAL=mspr
PLATFORM_EMAIL_DOMAIN=altdigital.ai

# Environment to single-character tier, used only in the email.
# The account alias keeps the full word: it is what appears in AWS support
# tickets and Cost Explorer, where 'prod' beats 'p' for a human reader.
#   dev -> d   test -> t   uat -> u   prod -> p
# No two environment names share a first letter, so the map is unambiguous.

# ---------------------------------------------------------------------------
# SSM Parameter Store namespace
# ---------------------------------------------------------------------------
# OU ids and derived platform facts are published here so no template ever
# hardcodes an OU id. Written in the management account at bootstrap; mirrored
# to Platform Tooling once that account exists.
PLATFORM_SSM_PREFIX=/platform

# ---------------------------------------------------------------------------
# Jira Cloud — change management system of record (design 08)
# ---------------------------------------------------------------------------
# Jira is the WORKFLOW layer. design 08 is explicit that it is not the record:
# "Jira history can be altered by a project admin, and auditors will ask about
# that." CloudTrail is the authoritative record of what happened, and approval
# evidence is snapshotted immutably at the moment of execution.
#
# Non-secret values only. The service account email and API token live in
# Secrets Manager under platform/jira/service-account, written by
# scripts/set-jira-token.sh — never here, and never on a command line.

# Site URL. A trailing slash is tolerated -- the Jira client strips it -- but
# leaving it off is tidier. e.g. https://altdigitalmsp.atlassian.net
PLATFORM_JIRA_SITE=https://altdigitalmsp.atlassian.net/

# AltDigital's OWN operations project — the issue-key prefix, not the project
# name. "AltDigital MSP Operations" might have the key MSPOPS.
#
# This holds what the PLATFORM raises: security incident dossiers, containment
# readouts, restore-test findings, alarm tickets drained from
# platform-jira-intents. One project, forever, and it is never tenant-facing.
#
# The audience is the reason, not the workflow. An incident readout carries a
# CloudTrail extract of what a principal did in the preceding 24 hours and
# whether the same indicators appear in other accounts. No tenant sees another
# tenant's estate, and no tenant sees AltDigital's internal security posture.
PLATFORM_JIRA_OPS_PROJECT=AIINFRA

# Change records are PER TENANT and are NOT configured here.
#
# design 08 routes an unapproved deployment to "the tenant's change approver",
# and questionnaire 1.7 already collects that per client. The project holding
# their change records is the sibling of that field and is resolved from the
# registry at reconciliation time, not from a global.
#
# Why per-project rather than one project with components and issue-level
# security: design 08's own warning is that "Jira permissions are easy to get
# subtly wrong". If tenant isolation depends on issue security inside a shared
# project, one permissions slip exposes tenant A's change records to tenant B.
# A project boundary is coarse and hard to get wrong.
#
# This does NOT conflict with open items B9 and D5, which call for ONE golden
# scheme shared across all tenants. One scheme, many projects.
#
# Used only until the first tenant is vested, so reconciliation has somewhere
# to look in the sandbox. Leave it pointing at the ops project.
PLATFORM_JIRA_DEFAULT_CHANGE_PROJECT=AIINFRA

# When the Jira API token expires. NOT a secret -- a date is not a credential,
# and this one needs to be visible enough to act on.
#
# Atlassian caps API token lifetime at one year. When this passes, change
# reconciliation degrades to "change source unavailable" -- correct behaviour,
# no false compliance findings -- and then stays that way silently until
# somebody notices. The expiry notice goes to the Atlassian account's email,
# which today is an alias rather than a monitored shared mailbox (B-070).
#
# So the platform watches this itself: every reconciliation run publishes
# JiraTokenDaysRemaining, and an alarm fires well before the date. Update this
# whenever the token is rotated.
PLATFORM_JIRA_TOKEN_EXPIRES=2027-09-19

# Issue type used for a change record. The reconciliation engine matches
# deployments against issues of this type; anything else in the project is
# ignored, so a wrong value here reads as "no change record found" for every
# deployment rather than as an error.
PLATFORM_JIRA_CHANGE_ISSUETYPE=Change

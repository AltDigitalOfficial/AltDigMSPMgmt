    {
      "Sid": "DenyHipaaExcludedFeatures",
      "Effect": "Deny",
      "Action": [
        "ds:CreateDirectory",
        "mobiletargeting:UpdateVoiceChannel",
        "sms-voice:SendNotifyVoiceMessage",
        "sms-voice:SendVoiceMessage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyHipaaExcludedFeaturesWhenWorkteamType",
      "Effect": "Deny",
      "Action": [
        "sagemaker:CreateFlowDefinition",
        "sagemaker:CreateLabelingJob"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "sagemaker:WorkteamType": [
            "public-crowd",
            "vendor-crowd"
          ]
        }
      }
    }

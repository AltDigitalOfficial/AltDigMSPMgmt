{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequireOwnerTag",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "s3:CreateBucket",
        "lambda:CreateFunction",
        "ecs:CreateService",
        "elasticloadbalancing:CreateLoadBalancer",
        "dynamodb:CreateTable"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:RequestTag/Owner": "true"
        },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/stacksets-exec-*",
            "arn:aws:iam::*:role/PlatformDeployer",
            "arn:aws:iam::*:role/PlatformExerciseHarness",
            "arn:aws:iam::*:role/PlatformRestoreExecution",
            "arn:aws:iam::*:role/PlatformHarnessProbe",
            "arn:aws:iam::*:role/aws-service-role/*"
          ]
        }
      }
    },
    {
      "Sid": "RequireApplicationTag",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "s3:CreateBucket",
        "lambda:CreateFunction",
        "ecs:CreateService",
        "elasticloadbalancing:CreateLoadBalancer",
        "dynamodb:CreateTable"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:RequestTag/Application": "true"
        },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/stacksets-exec-*",
            "arn:aws:iam::*:role/PlatformDeployer",
            "arn:aws:iam::*:role/PlatformExerciseHarness",
            "arn:aws:iam::*:role/PlatformRestoreExecution",
            "arn:aws:iam::*:role/PlatformHarnessProbe",
            "arn:aws:iam::*:role/aws-service-role/*"
          ]
        }
      }
    },
    {
      "Sid": "RequireDataClassificationTag",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "s3:CreateBucket",
        "lambda:CreateFunction",
        "ecs:CreateService",
        "elasticloadbalancing:CreateLoadBalancer",
        "dynamodb:CreateTable"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:RequestTag/DataClassification": "true"
        },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/stacksets-exec-*",
            "arn:aws:iam::*:role/PlatformDeployer",
            "arn:aws:iam::*:role/PlatformExerciseHarness",
            "arn:aws:iam::*:role/PlatformRestoreExecution",
            "arn:aws:iam::*:role/PlatformHarnessProbe",
            "arn:aws:iam::*:role/aws-service-role/*"
          ]
        }
      }
    },
    {
      "Sid": "DataClassificationMustBeOneOfFour",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "s3:CreateBucket",
        "lambda:CreateFunction",
        "ecs:CreateService",
        "elasticloadbalancing:CreateLoadBalancer",
        "dynamodb:CreateTable"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": {
          "aws:RequestTag/DataClassification": [
            "public",
            "internal",
            "confidential",
            "regulated"
          ]
        },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/stacksets-exec-*",
            "arn:aws:iam::*:role/PlatformDeployer",
            "arn:aws:iam::*:role/PlatformExerciseHarness",
            "arn:aws:iam::*:role/PlatformRestoreExecution",
            "arn:aws:iam::*:role/PlatformHarnessProbe",
            "arn:aws:iam::*:role/aws-service-role/*"
          ]
        }
      }
    },
    {
      "Sid": "PlatformLayerMustBePresentAndOneOfTwo",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "s3:CreateBucket",
        "lambda:CreateFunction",
        "ecs:CreateService",
        "elasticloadbalancing:CreateLoadBalancer",
        "dynamodb:CreateTable"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/platform-layer": [
            "infrastructure",
            "application"
          ]
        },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/stacksets-exec-*",
            "arn:aws:iam::*:role/PlatformDeployer",
            "arn:aws:iam::*:role/PlatformExerciseHarness",
            "arn:aws:iam::*:role/PlatformRestoreExecution",
            "arn:aws:iam::*:role/PlatformHarnessProbe",
            "arn:aws:iam::*:role/aws-service-role/*"
          ]
        }
      }
    },
    {
      "Sid": "ProtectPlatformManagedTags",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource",
        "lambda:TagResource",
        "lambda:UntagResource",
        "s3:PutBucketTagging",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "ecs:TagResource",
        "ecs:UntagResource",
        "tag:TagResources",
        "tag:UntagResources"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "platform-managed",
            "AlarmTier",
            "BackupPolicy",
            "PatchGroup",
            "BaselineVersion",
            "InstrumentedAt"
          ]
        },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/stacksets-exec-*",
            "arn:aws:iam::*:role/PlatformDeployer",
            "arn:aws:iam::*:role/PlatformSecurityResponder",
            "arn:aws:iam::*:role/PlatformRestoreWorker",
            "arn:aws:iam::*:role/PlatformExerciseHarness",
            "arn:aws:iam::*:role/PlatformBackupService",
            "arn:aws:iam::*:role/PlatformRestoreExecution",
            "arn:aws:iam::*:role/aws-service-role/*"
          ]
        }
      }
    }
  ]
}

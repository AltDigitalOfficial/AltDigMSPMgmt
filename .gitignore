# Personal data — names, emails and phone numbers for AWS alternate contacts.
# Never committed. Copy config/contacts.env.example and fill in locally.
#
# Glob, not an exact match: an exact 'config/contacts.env' would leave a
# contacts.env.bak or contacts.env.old tracked. The .example file is
# re-included below because it holds only empty placeholders.
config/contacts.env*
!config/contacts.env.example

# Identity Center group membership — names and direct email addresses.
# Same rule, same reason. Copy config/identity.env.example and fill in locally.
config/identity.env*
!config/identity.env.example

# Local AWS and tooling state
.aws-sam/
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl.bak

# Completed onboarding questionnaires carry named contacts with direct email
# addresses — technical, escalation, change approver, billing, developer
# manager. Same class of data as config/contacts.env and the same rule.
#
# The example and the schema are placeholders and structure only, and are
# re-included below.
*.questionnaire.yaml
*.questionnaire.yml
*.questionnaire.json
!questionnaire.example.yaml
!questionnaire.schema.json

# Terraform variable files hold responder email addresses — personal data by
# the same rule as config/contacts.env. Same glob-not-exact-match reasoning:
# a terraform.tfvars.bak must not survive the rule. The .example file holds
# placeholders only and is re-included.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Build output
dist/
build/
node_modules/

# Scratch
*.log
tmp/
scratch/
